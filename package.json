{
  "name": "wtv",
  "description": "Web TV: turn the browser into a TV station where videos and audio are the shows.",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "wxt",
    "check": "npm run compile && npm test",
    "build": "npm run check && wxt build",
    "build:dev": "npm run check && wxt build --mode devtools",
    "zip": "npm run check && wxt zip",
    "lan:build": "npm run check && wxt build --mode lan",
    "lan:serve": "node --experimental-strip-types scripts/lan/serve.ts",
    "icons": "swift -O scripts/brand/icons.swift",
    "compile": "wxt prepare && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "health": "wxt build && node --experimental-strip-types scripts/health/run.ts",
    "health:setup": "wxt build && node --experimental-strip-types scripts/health/run.ts --setup",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@mozilla/readability": "0.6.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "playwright": "1.64.1",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12",
    "wxt": "0.21.4"
  }
}
