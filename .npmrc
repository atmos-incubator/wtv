# npm 10.x crashes ("Cannot read properties of null (reading 'edgesOut')") while walking
# vitest's optional peer chain: vitest -> ... -> @vitejs/devtools-vitest -> vitest@*, which
# resolves to a newer vitest whose peers conflict with the pinned one. None of those optional
# peers are installed anyway. Required peers (vite, typescript) are declared explicitly in
# package.json, so skipping automatic peer installation is safe here.
legacy-peer-deps=true
