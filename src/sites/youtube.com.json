{
  "schemaVersion": 1,
  "id": "youtube.com",
  "name": "YouTube",
  "domains": [
    "youtube.com"
  ],
  "roles": {
    "video": [
      "#movie_player video.html5-main-video",
      "video.html5-main-video"
    ],
    "player": [
      "#movie_player"
    ],
    "adIndicator": [
      "div.ytp-ad-badge__text--clean-player",
      {
        "selector": "#movie_player.ad-showing",
        "when": "exists"
      },
      {
        "selector": "#movie_player.ad-interrupting",
        "when": "exists"
      }
    ],
    "skip": [
      "button.ytp-skip-ad-button",
      ".ytp-skip-ad-button",
      ".ytp-ad-skip-button-modern",
      ".ytp-ad-skip-button"
    ],
    "continuePrompt": [
      "ytd-popup-container yt-confirm-dialog-renderer #confirm-button button"
    ],
    "playButton": [
      {
        "selector": "button.ytp-play-button",
        "when": "exists"
      },
      "button[data-title-no-tooltip=\"Pause\"]",
      ".ytp-play-button"
    ],
    "progressBar": [
      ".ytp-progress-bar"
    ],
    "title": [
      "ytd-watch-metadata #title h1",
      "h1.ytd-watch-metadata"
    ],
    "description": [
      "ytd-watch-metadata #description-inline-expander",
      "#description"
    ],
    "keywords": [
      "meta[name=\"keywords\"]"
    ],
    "creator": [
      "ytd-watch-metadata ytd-channel-name a",
      "#owner #channel-name a"
    ]
  },
  "quirks": {
    "controlBarInset": 48,
    "adsInMainVideo": true
  }
}
